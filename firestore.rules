rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    match /admins/{adminId} {
      allow read: if signedIn() && request.auth.uid == adminId;
      allow write: if false;
    }

    match /alerts/{alertId} {
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          'userId',
          'createdAt',
          'status'
        ])
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'active'
        && request.resource.data.createdAt is timestamp;

      allow read: if isAdmin()
        || (signedIn() && resource.data.userId == request.auth.uid);

      allow update: if (
          isAdmin()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status',
            'acknowledgedAt',
            'resolvedAt',
            'safeAt',
            'lastUpdatedAt'
          ])
          && request.resource.data.status in ['active', 'acknowledged', 'resolved', 'safe']
        )
        || (
          signedIn()
          && resource.data.userId == request.auth.uid
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status',
            'safeAt',
            'lastUpdatedAt'
          ])
          && request.resource.data.status == 'safe'
          && request.resource.data.safeAt is timestamp
        );

      allow delete: if false;
    }
  }
}